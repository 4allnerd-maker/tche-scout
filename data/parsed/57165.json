1", "numero": 9, "tipo": "NR", "jogador": "Matheus Vinicius Guimaraes", "equipe": "Veranópolis / RS"}, {"tempo": "+1", "periodo": "1", "numero": 6, "tipo": "PN", "jogador": "Erinaldo Santos Rabelo", "equipe": "Apafut / RS"}, {"tempo": "33:00", "periodo": "2", "numero": 20, "tipo": "FT", "jogador": "Marcelo Machado Vilela", "equipe": "Veranópolis / RS"}], "cartoes_amarelos": [{"tempo": "30:00", "periodo": "1T", "numero": 5, "jogador": "Sampson Nunes da Silva", "equipe": "Veranópolis / RS", "motivo": "Motivo: 241 - Dar ou tentar dar um pontapé (chute) em um adversário de maneira temerária na disputa da bola. - Por chutar o seu adversário de maneira temerária na disputa da bola."}, {"tempo": "39:00", "periodo": "1T", "numero": null, "jogador": "Bruno da Costa de Oliveira", "equipe": "Apafut / RS", "motivo": "Motivo: 255 - Atuar de maneira a mostrar desrespeito ao jogo. - Por mostrar desrespeito ao jogo devido a agir de forma provocativa e inflamatória, ao provocar verbalmente os adversários estando sentado no banco de reservas da área técnica da sua equipe."}, {"tempo": "40:00", "periodo": "1T", "numero": 7, "jogador": "Thiago Magno Barbosa de Castro Moreira", "equipe": "Veranópolis / RS", "motivo": "Motivo: 265 - Distrair ou atrapalhar, de forma incorreta, o adversário executor de um arremesso lateral. - Por atrapalhar de forma incorreta a execução de um arremesso lateral para equipe adversária, retirando a bola das mãos do adversário quando o mesmo estava iniciando a cobrança do lateral, com o intuito de retardar o reinicio do jogo."}, {"tempo": "13:00", "periodo": "2T", "numero": 12, "jogador": "Bruno Eduardo Cantelle", "equipe": "Veranópolis / RS", "motivo": "Motivo: 357 - Reclamar / protestar (verbalmente ou por gestos) ostensivamente contra decisão da arbitragem. - Por protestar verbalmente contra as decisões da arbitragem estando no banco de reservas da área técnica da sua equipe."}, {"tempo": "16:00", "periodo": "2T", "numero": 20, "jogador": "Filipe Fortes Fraga", "equipe": "Apafut / RS", "motivo": "Motivo: 244 - Segurar um adversário por motivo tático para afastá-lo da bola. - Por segurar seu adversário pela camiseta para afastá-lo da bola."}, {"tempo": "27:00", "periodo": "2T", "numero": 8, "jogador": "Renan Metz", "equipe": "Veranópolis / RS", "motivo": "Motivo: 357 - Reclamar / protestar (verbalmente ou por gestos) ostensivamente contra decisão da arbitragem. - Por reclamar verbalmente de forma ostensiva contra as decisões da arbitragem."}, {"tempo": "+04:00", "periodo": "2T", "numero": 11, "jogador": "Marcos Vinicius dos Santos", "equipe": "Apafut / RS", "motivo": "Motivo: 254 - Dar uma entrada contra um adversário de maneira temerária na disputa da bola. - Por acertar as pernas do adversário com um carrinho de forma temerária na disputa da bola"}], "cartoes_vermelhos": [{"tempo": "-", "periodo": "PJ", "numero": 10, "jogador": "Eduardo Menezes - Apafut", "equipe": null, "motivo": ""}, {"tempo": "Cartão Vermelho Direto", "periodo": "", "numero": null, "jogador": "Motivo: 384 - Empregar linguagem e/ou gesticular de maneira ofensiva, grosseira ou abusiva. - Expulsei após o término da partida o", "equipe": null, "motivo": "atleta N° 10 da equipe Apafut, Sr. Eduardo Menezes, com a apresentação do cartão vermelho direto devido ao mesmo adentrar ao campo de jogo após o fim da partida, e proferir as seguintes palavras em direção ao árbitro da partida \"Tu é muito fraco, muito fraco, tu é um merda\", após a apresentação do cartão vermelho o atleta bateu palmas de forma irônica e debochada, além de repetir \"fraco, fraco, seu merda\". O referido atleta precisou ser retirado do campo de jogo pelo seus companheiros de equipe, que dessa forma lhe retiraram até o vestiário da equipe mandante. Informo que me senti ofendido com as palavras proferidas pelo Sr. Eduardo Menezes."}], "substituicoes": [{"tempo": "00:00", "periodo": "INT", "equipe": "Veranópolis / RS", "entrou_numero": 19, "entrou": "Gregory Souza Angelo", "saiu_numero":